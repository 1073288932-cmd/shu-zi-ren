# Deepseek API key — 仅供主进程读取，不得出现在 renderer 代码、日志或错误信息中
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Silicon Flow Whisper API key — 用于语音转写（push-to-talk）
# 申请地址：https://cloud.siliconflow.cn
# env-only，不写入 userData/config.json，不可在运行时通过 UI 修改
SILICONFLOW_API_KEY=

# 腾讯云数智人 IVH API（用于真实口型同步）
# 申请地址：https://cloud.tencent.com/product/ivh
# 缺少 APPKEY 或 ACCESSTOKEN 时，视频链路自动禁用，回退到 Web Speech
TENCENT_IVH_APPKEY=
TENCENT_IVH_ACCESSTOKEN=
TENCENT_IVH_ENDPOINT=gw.tvs.qq.com

# 腾讯云 COS（图片托管 — 仅私有桶 + 签名 URL）
# SecretId/SecretKey 仅供 COS 使用，不用于数智人 API 鉴权
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_BUCKET=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 默认 true：使用 7 天签名 URL；改 false 才启用公网读，且角色图将以可猜难度低的 URL 公开可访问
TENCENT_COS_USE_SIGNED_URL=true
