# Deepseek API key — 仅供主进程读取，不得出现在 renderer 代码、日志或错误信息中
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Silicon Flow Whisper API key — 用于语音转写（push-to-talk）
# 申请地址：https://cloud.siliconflow.cn
# env-only，不写入 userData/config.json，不可在运行时通过 UI 修改
SILICONFLOW_API_KEY=

# 魔珐星云 具身驱动 SDK — 3D 数字人主渲染（云端模式）
# 控制台：https://www.xingyun3d.com → 应用 → App密钥
# 仅主进程读取，经 IPC 注入 renderer；单点受控部署，勿对外分发打包含密钥的产物
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=
XINGYUN_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session
